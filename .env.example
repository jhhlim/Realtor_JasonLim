# =============================================================================
# Jason Lim Real Estate — environment variables
# Copy to .env.local and fill in values. Never commit real secrets.
# =============================================================================

# Site
NEXT_PUBLIC_SITE_URL=https://realtor-jason-lim.vercel.app

# Scheduling — use your real Calendly event URL (required for embed to load)
# Example: https://calendly.com/your-handle/30min
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jason-lim-compass/consultation

# Maps: leaflet | google | mapbox
NEXT_PUBLIC_MAP_PROVIDER=leaflet
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# MLS / listings provider:
# mock | realtyapi | bridge | idx | mls-grid | simplyrets | trestle | estated | reso
MLS_PROVIDER=mock
REALTY_API_KEY=
REALTY_API_HOST=
BRIDGE_API_KEY=
IDX_API_KEY=
MLS_GRID_TOKEN=
SIMPLYRETS_USERNAME=
SIMPLYRETS_PASSWORD=
TRESTLE_CLIENT_ID=
TRESTLE_CLIENT_SECRET=
ESTATED_API_KEY=

# CRM: followupboss | kvcore | lofty | cinc | hubspot | salesforce | gohighlevel
CRM_PROVIDER=
FOLLOW_UP_BOSS_API_KEY=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_ACCESS_TOKEN=

# Newsletter: mailchimp | convertkit | beehiiv | kit
NEWSLETTER_PROVIDER=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
CONVERTKIT_API_KEY=
BEEHIIV_API_KEY=

# Email (Resend) — forms deliver TO jason.lim@compass.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=jason.lim@compass.com
# FROM must be a domain verified in Resend (cannot use @compass.com unless you control that DNS).
# Until your custom domain is verified, use:
EMAIL_FROM="Jason Lim <onboarding@resend.dev>"
# After verifying e.g. jasonlimrealty.com:
# EMAIL_FROM="Jason Lim <hello@jasonlimrealty.com>"

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_CLARITY_ID=

# AI (optional, future)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Messaging / payments / docs (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
DOCUSIGN_INTEGRATION_KEY=

# Data stores (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PINECONE_API_KEY=
